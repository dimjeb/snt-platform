# === База данных ===
POSTGRES_DB=snt
POSTGRES_USER=snt
POSTGRES_PASSWORD=changeme_strong_password

# === Django ===
SECRET_KEY=changeme_django_secret_key_50_chars_minimum
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DOMAIN=snt.example.ru

# === Email (SMTP) ===
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=noreply@snt.example.ru
EMAIL_HOST_PASSWORD=changeme_email_password
DEFAULT_FROM_EMAIL=СНТ-Платформа <noreply@snt.example.ru>

# === Redis / Celery ===
REDIS_URL=redis://redis:6379/0

# === Платёжный агрегатор (этап 4, ЮКасса) ===
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=

# === SMS (опционально) ===
# SMSAERO_EMAIL=
# SMSAERO_API_KEY=

# Резервные копии на Яндекс Диск (scripts/backup.sh)
# Пароль шифрования — длинный случайный; хранить ЕЩЁ И в менеджере паролей.
BACKUP_PASSPHRASE=
# OAuth-токен Яндекс Диска с правом cloud_api:disk.write
YANDEX_DISK_TOKEN=
# Глубина копий, дней (на сервере и на Яндекс Диске)
BACKUP_KEEP_DAYS=14
