{$DOMAIN::80} {
    # API и Django admin
    handle /api/* {
        reverse_proxy backend:8000
    }
    handle /admin/* {
        reverse_proxy backend:8000
    }
    handle /static/* {
        root * /srv
        file_server
    }
    handle /media/* {
        root * /srv
        file_server
    }
    # SPA frontend — всё остальное
    handle {
        root * /srv/www
        try_files {path} /index.html
        file_server
    }
    encode gzip
}
